PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xianfires_erp
DB_USER=root
DB_PASSWORD=
# Long random string used to sign the session cookie
SESSION_SECRET=change-me
# true shows a "Create an account" page that makes ADMIN accounts. Local setup only; keep it off in production.
ALLOW_SIGNUP=false
# ERP integration API (/api/v1): comma-separated browser origins allowed to call it directly.
# Leave empty for server-to-server calls (recommended); API keys must not be exposed in browsers.
API_CORS_ORIGINS=
