{{> head}}
<body>
{{> adminHeader}}
<div class="flex">
  {{> adminNav}}
  <main class="flex-1 min-w-0 px-4 md:px-8 py-8">
    <div class="max-w-[75rem] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-6 gap-5">
        <div class="lg:col-span-2">
          <div class="card p-4 flex items-center justify-between gap-3 bg-primary/5 border-primary/20" data-active="true">
            <div>
              <a href="{{ urls.accountingSetting }}" class="uppercase text-xs font-semibold text-primary">Accounting Setting</a>
              <div class="text-sm text-muted mt-1">Company details and ledger rules</div>
            </div>
            <a href="{{ urls.accountingSetting }}" class="btn btn-outline h-8 px-2" aria-label="Accounting Setting">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 18v-7"/><path d="M11.12 2.198a2 2 0 0 1 1.76.006l7.866 3.847c.476.233.31.949-.22.949H3.474c-.53 0-.695-.716-.22-.949z"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg>
            </a>
          </div>
        </div>
        <div class="lg:col-span-4">
          <form id="accountingSetting" method="POST" action="{{ urls.saveSetting }}" novalidate data-json-form>
            <div class="card">
              <div class="card-header">
                <div class="card-title">Accounting Settings</div>
                <p class="card-description">Company details and ledger rules</p>
              </div>
              <div class="card-content space-y-3">
                <div class="card-title">Company</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="field-label" for="accountingCompanyName">Registered Company Name</label>
                    <input id="accountingCompanyName" name="accountingCompanyName" class="input" placeholder="Juan Dela Cruz Trading" value="{{ accountingSettings.companyName }}">
                  </div>
                  <div>
                    <label class="field-label" for="accountingCompanyTin">Tax Identification Number (TIN)</label>
                    <input id="accountingCompanyTin" name="accountingCompanyTin" class="input" placeholder="000-000-000-000" value="{{ accountingSettings.companyTin }}">
                  </div>
                </div>
                <div>
                  <label class="field-label" for="accountingCompanyAddress">Registered Address</label>
                  <textarea id="accountingCompanyAddress" name="accountingCompanyAddress" class="textarea">{{ accountingSettings.companyAddress }}</textarea>
                </div>
              </div>
              <div class="card-content pt-3 border-t border-border space-y-3">
                <div class="card-title">Ledger</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="field-label" for="accountingCurrency">Ledger Currency</label>
                    <select id="accountingCurrency" name="accountingCurrency" class="select">
                      {{#each currencies}}
                      <option value="{{ code }}" {{#if selected}}selected{{/if}}>{{ code }} - {{ name }}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div>
                    <label class="field-label" for="accountingFiscalYearStart">Fiscal Year Starts In</label>
                    <select id="accountingFiscalYearStart" name="accountingFiscalYearStart" class="select">
                      {{#each months}}
                      <option value="{{ value }}" {{#if selected}}selected{{/if}}>{{ label }}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div>
                    <label class="field-label" for="accountingEntryPrefix">Journal Entry Number Prefix</label>
                    <input id="accountingEntryPrefix" name="accountingEntryPrefix" class="input" placeholder="JE-" value="{{ accountingSettings.entryPrefix }}"
                      data-maxlength="{{ maxPrefixLength }}" data-maxlength-message="Use {{ maxPrefixLength }} characters or fewer">
                    <p class="field-help">Example: JE-000123</p>
                  </div>
                </div>
              </div>
              <div class="card-content pt-3 border-t border-border space-y-3">
                <div class="card-title">Sales &amp; Purchases</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {{#each controlAccounts}}
                  <div>
                    <label class="field-label" for="{{ key }}">{{ label }} account</label>
                    <select id="{{ key }}" name="{{ key }}" class="select">
                      {{#each options}}<option value="{{ uuid }}" {{#if selected}}selected{{/if}}>{{ label }}</option>{{/each}}
                    </select>
                  </div>
                  {{/each}}
                  <div>
                    <label class="field-label" for="accountingVatRate">VAT rate (%)</label>
                    <input id="accountingVatRate" name="accountingVatRate" type="number" min="0" max="100" step="0.01" class="input" value="{{ salesPurchase.vatRate }}">
                  </div>
                  <div>
                    <label class="field-label" for="accountingPaymentTermsDays">Default payment terms (days)</label>
                    <input id="accountingPaymentTermsDays" name="accountingPaymentTermsDays" type="number" min="0" max="365" step="1" class="input" value="{{ salesPurchase.paymentTermsDays }}">
                  </div>
                  <div>
                    <label class="field-label" for="accountingInvoicePrefix">Sales Invoice Number Prefix</label>
                    <input id="accountingInvoicePrefix" name="accountingInvoicePrefix" class="input" value="{{ salesPurchase.invoicePrefix }}"
                      data-maxlength="{{ maxPrefixLength }}" data-maxlength-message="Use {{ maxPrefixLength }} characters or fewer">
                  </div>
                  <div>
                    <label class="field-label" for="accountingBillPrefix">Bill Number Prefix</label>
                    <input id="accountingBillPrefix" name="accountingBillPrefix" class="input" value="{{ salesPurchase.billPrefix }}"
                      data-maxlength="{{ maxPrefixLength }}" data-maxlength-message="Use {{ maxPrefixLength }} characters or fewer">
                  </div>
                </div>
              </div>
              <div class="px-5 pb-5 flex justify-end w-full">
                <button type="submit" class="btn btn-primary" form="accountingSetting">Save Settings</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="/js/accounting-setting.js" defer></script>
{{> footer }}