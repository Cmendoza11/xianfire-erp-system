{{> head}}
<body>
{{> adminHeader}}
<div class="flex">
  {{> adminNav}}
  <main class="flex-1 min-w-0 px-4 md:px-8 py-8">
    <div class="max-w-[60rem] mx-auto space-y-5">
      {{#if contact}}
      {{> pageHeading heading=contact.name backUrl=page.gridUrl }}
      {{else}}
      {{> pageHeading heading=(concat "New " (lowercase typeInfo.label)) backUrl=page.gridUrl }}
      {{/if}}
      <form id="contactForm" method="POST" action="{{ form.action }}" novalidate data-json-form data-method="{{ form.method }}"
        {{#if contact}}data-success-message="{{ typeInfo.label }} saved"{{else}}data-success-message="{{ typeInfo.label }} created" data-success-redirect="{{ page.gridUrl }}"{{/if}}>
        <input type="hidden" name="type" value="{{ type }}">
        <div class="card">
          <div class="card-header"><div class="card-title">{{ typeInfo.label }} details</div></div>
          <div class="card-content grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="sm:col-span-2">
              <label class="field-label" for="name">Name<span class="required">*</span></label>
              <input id="name" name="name" class="input" value="{{ values.name }}" data-required="Name is required">
            </div>
            <div>
              <label class="field-label" for="tin">TIN</label>
              <input id="tin" name="tin" class="input" placeholder="000-000-000-000" value="{{ values.tin }}">
            </div>
            <div>
              <label class="field-label" for="email">Email</label>
              <input id="email" name="email" type="email" class="input" value="{{ values.email }}">
            </div>
            <div>
              <label class="field-label" for="phone">Phone</label>
              <input id="phone" name="phone" class="input" value="{{ values.phone }}">
            </div>
            <div>
              <label class="field-label" for="status">Status</label>
              <select id="status" name="status" class="select">
                <option value="1" {{#if (eq values.status 1)}}selected{{/if}}>Active</option>
                <option value="0" {{#if (eq values.status 0)}}selected{{/if}}>Inactive</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="field-label" for="address">Address</label>
              <textarea id="address" name="address" class="textarea">{{ values.address }}</textarea>
            </div>
          </div>
        </div>
        <div class="form-submit-button flex border-t border-border mt-4 pt-4 justify-between">
          <a href="{{ page.gridUrl }}" class="btn btn-destructive">Cancel</a>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>

      {{#if contact}}
      <div class="card">
        <div class="card-header"><div class="card-title">{{ documentLabel }}</div></div>
        <div class="card-content overflow-x-auto">
          <table class="data-table">
            <thead><tr><th>No.</th><th>Date</th><th>Due</th><th>Status</th><th class="num">Total</th><th class="num">Balance</th></tr></thead>
            <tbody>
              {{#each documents}}
              <tr>
                <td><a href="{{ viewUrl }}" class="hover:underline font-mono">{{ number }}</a></td>
                <td>{{ issueDate }}</td>
                <td>{{ dueDate }}</td>
                <td>{{> documentStatus }}</td>
                <td class="num">{{ formatMoney total }}</td>
                <td class="num">{{ formatMoney balance }}</td>
              </tr>
              {{else}}
              <tr><td colspan="6" class="text-center text-muted">None yet</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
      {{/if}}
    </div>
  </main>
</div>
{{> footer }}