{{> head}}
<body>
{{> adminHeader}}
<div class="flex">
  {{> adminNav}}
  <main class="flex-1 min-w-0 px-4 md:px-8 py-8">
    <div class="max-w-[75rem] mx-auto space-y-5">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h1 class="text-xl font-semibold">{{#if company}}{{ company }}{{else}}Dashboard{{/if}}</h1>
          <p class="text-sm text-muted">{{ fiscalYear }} to date ({{ period.from }} to {{ period.to }}) · amounts in {{ currency }}{{#if lockDate}} · books closed through {{ lockDate }}{{/if}}</p>
        </div>
        {{#if can.write}}
        <div class="flex flex-wrap gap-2">
          <a href="{{ urls.invoiceNew }}" class="btn btn-primary">New invoice</a>
          <a href="{{ urls.billNew }}" class="btn btn-outline">New bill</a>
          <a href="{{ urls.accountingJournalNew }}" class="btn btn-outline">New journal entry</a>
        </div>
        {{/if}}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="kpi">
          <div class="kpi-label">Cash &amp; bank</div>
          <div class="kpi-value">{{ formatSignedMoney cash.total }}</div>
          <div class="kpi-sub">{{#each cash.accounts}}<a href="{{ ledgerUrl }}" class="hover:underline">{{ name }}: {{ formatSignedMoney balance }}</a>{{#unless @last}} · {{/unless}}{{/each}}</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Revenue</div>
          <div class="kpi-value">{{ formatSignedMoney revenue }}</div>
          <div class="kpi-sub">{{ fiscalYear }} to date</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Expenses</div>
          <div class="kpi-value">{{ formatSignedMoney expenses }}</div>
          <div class="kpi-sub">{{ fiscalYear }} to date</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">{{#if isLoss}}Net loss{{else}}Net income{{/if}}</div>
          <div class="kpi-value {{#if isLoss}}text-destructive{{else}}text-primary{{/if}}">{{ formatSignedMoney netIncome }}</div>
          <div class="kpi-sub"><a href="{{ urls.reportIncomeStatement }}" class="hover:underline">View income statement</a></div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Receivables</div>
          <div class="kpi-value">{{ formatMoney receivables.outstanding }}</div>
          <div class="kpi-sub">{{ receivables.openCount }} open invoice(s){{#if (gt receivables.overdue 0)}} · <span class="text-destructive">{{ formatMoney receivables.overdue }} overdue</span>{{/if}}</div>
        </div>
        <div class="kpi">
          <div class="kpi-label">Payables</div>
          <div class="kpi-value">{{ formatMoney payables.outstanding }}</div>
          <div class="kpi-sub">{{ payables.openCount }} open bill(s){{#if (gt payables.overdue 0)}} · <span class="text-destructive">{{ formatMoney payables.overdue }} overdue</span>{{/if}}</div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div class="card-title">Revenue and expenses by month</div>
          <p class="card-description">
            <span class="inline-block w-3 h-2 rounded bg-primary align-middle"></span> Revenue
            <span class="inline-block w-3 h-2 rounded bg-orange-400 align-middle ml-3"></span> Expenses
          </p>
        </div>
        <div class="card-content overflow-x-auto">
          <table class="data-table">
            <thead><tr><th>Month</th><th class="w-1/3"></th><th class="num">Revenue</th><th class="num">Expenses</th><th class="num">Net</th></tr></thead>
            <tbody>
              {{#each monthly}}
              <tr>
                <td class="whitespace-nowrap">{{ label }}</td>
                <td>
                  <div class="bar bg-primary mb-1" style="width: {{ revenueWidth }}%"></div>
                  <div class="bar bg-orange-400" style="width: {{ expenseWidth }}%"></div>
                </td>
                <td class="num">{{ formatSignedMoney revenue }}</td>
                <td class="num">{{ formatSignedMoney expense }}</td>
                <td class="num {{#if isLoss}}text-destructive{{/if}}">{{ formatSignedMoney net }}</td>
              </tr>
              {{else}}
              <tr><td colspan="5" class="text-center text-muted">No revenue or expenses posted in this fiscal year yet</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <div class="card">
          <div class="card-header"><div class="card-title">Overdue invoices</div></div>
          <div class="card-content">
            <table class="data-table">
              <tbody>
                {{#each overdueInvoices}}
                <tr>
                  <td><a href="{{ viewUrl }}" class="hover:underline font-mono">{{ number }}</a></td>
                  <td>{{ contact.name }}</td>
                  <td class="text-destructive whitespace-nowrap">{{ daysOverdue }} days</td>
                  <td class="num">{{ formatMoney balance }}</td>
                </tr>
                {{else}}
                <tr><td class="text-muted">No overdue invoices</td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">Overdue bills</div></div>
          <div class="card-content">
            <table class="data-table">
              <tbody>
                {{#each overdueBills}}
                <tr>
                  <td><a href="{{ viewUrl }}" class="hover:underline font-mono">{{ number }}</a></td>
                  <td>{{ contact.name }}</td>
                  <td class="text-destructive whitespace-nowrap">{{ daysOverdue }} days</td>
                  <td class="num">{{ formatMoney balance }}</td>
                </tr>
                {{else}}
                <tr><td class="text-muted">No overdue bills</td></tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header flex justify-between items-center">
          <div class="card-title">Recent journal entries</div>
          <a href="{{ urls.accountingJournalGrid }}" class="text-sm text-primary hover:underline">View all</a>
        </div>
        <div class="card-content overflow-x-auto">
          <table class="data-table">
            <tbody>
              {{#each recentEntries}}
              <tr>
                <td><a href="{{ viewUrl }}" class="hover:underline font-mono">{{ entryNumber }}</a></td>
                <td class="whitespace-nowrap">{{ entryDate }}</td>
                <td>{{ description }}</td>
                <td><span class="badge badge-secondary">{{ entryTypeLabel }}</span></td>
                <td class="num">{{ formatMoney totalDebit }}</td>
              </tr>
              {{else}}
              <tr><td class="text-muted">No journal entries yet</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
{{> footer }}