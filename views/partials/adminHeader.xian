<header class="app-header">
  <div class="flex items-center gap-2.5">
    <button type="button" class="p-2 -ml-2 rounded-lg hover:bg-white" data-nav-toggle aria-label="Toggle menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a href="{{ urls.dashboard }}" class="flex items-center gap-2">
      {{> logo class="w-7 h-7" }}
      <span class="text-sm font-semibold">XianFire Accounting</span>
    </a>
  </div>
  <div class="flex items-center gap-1">
    <button type="button" class="p-2 rounded-lg text-muted hover:bg-white hover:text-ink" data-palette-open aria-label="Search pages and actions">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
    {{> accountMenu placement="header" }}
  </div>
</header>
