<nav data-nav class="hidden md:block w-60 shrink-0 bg-white border-r border-border min-h-[calc(100vh-3.5rem)] p-4 md:sticky md:top-14 md:self-start md:max-h-[calc(100vh-3.5rem)] md:overflow-y-auto">
