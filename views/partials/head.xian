<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#008060",
            destructive: "#d72c0d",
            border: "#e1e3e5",
            muted: "#6d7175"
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin.js" defer></script>
  <title>{{ title }} </title>
</head>