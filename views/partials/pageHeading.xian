<div class="page-heading flex flex-wrap items-center justify-between gap-3 mb-5">
  <div class="flex items-center gap-2 min-w-0">
    {{#if backUrl}}
    <a href="{{ backUrl }}" class="border border-border rounded p-1.5 bg-white hover:bg-gray-50" aria-label="Back">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    {{/if}}
    <h1 class="text-xl font-semibold text-gray-900 truncate">{{ heading }}</h1>
  </div>
  {{#if actionUrl}}
  <a href="{{ actionUrl }}" class="btn btn-primary">{{ actionLabel }}</a>
  {{/if}}
</div>