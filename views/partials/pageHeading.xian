<div class="page-heading flex flex-wrap items-center justify-between gap-3 mb-6">
  <div class="flex items-center gap-1.5 min-w-0">
    {{#if backUrl}}
    <a href="{{ backUrl }}" class="-ml-1.5 rounded-lg p-1.5 text-muted transition-colors hover:bg-white hover:text-ink" aria-label="Back">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
    </a>
    {{/if}}
    <h1 class="text-[1.375rem] font-semibold tracking-tight text-ink truncate">{{ heading }}</h1>
  </div>
  {{#if actionUrl}}
  <a href="{{ actionUrl }}" class="btn btn-primary">{{ actionLabel }}</a>
  {{/if}}
</div>
