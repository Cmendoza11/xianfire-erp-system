{{> head}}
<body>
{{> adminHeader}}
<div class="flex">
  {{> adminNav}}
  <main class="flex-1 min-w-0 px-4 md:px-8 py-8">
    <div class="max-w-[75rem] mx-auto">
      <div class="no-print">
        {{> pageHeading heading=title }}
        <form method="GET" action="{{ formAction }}" class="card p-4 mb-5 flex flex-wrap items-end gap-3">
          <label class="grid gap-1 text-sm"><span class="font-medium">As of</span><input type="date" name="as_of" class="input" value="{{ asOf }}"></label>
          <button type="submit" class="btn btn-primary">Generate</button>
          <button type="button" class="btn btn-outline" data-print>Print</button>
        </form>
      </div>
      <div class="card p-6 space-y-6">
        {{> reportHeader reportTitle=title periodLabel=(concat "As of " asOf) }}
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>{{ contactLabel }}</th>
                {{#each buckets}}<th class="num">{{ label }}</th>{{/each}}
                <th class="num">Total</th>
              </tr>
            </thead>
            <tbody>
              {{#each report.contacts}}
              <tr>
                <td>{{ name }}</td>
                {{#each buckets}}<td class="num">{{#if (gt this 0)}}{{ formatMoney this }}{{else}}-{{/if}}</td>{{/each}}
                <td class="num font-medium">{{ formatMoney total }}</td>
              </tr>
              {{else}}
              <tr><td colspan="7" class="text-center text-muted">Nothing outstanding</td></tr>
              {{/each}}
              <tr class="report-row-grand">
                <td>Total</td>
                {{#each report.totals.buckets}}<td class="num">{{ formatMoney this }}</td>{{/each}}
                <td class="num">{{ formatMoney report.totals.total }}</td>
              </tr>
            </tbody>
          </table>
        </div>
        {{#if report.documents.length}}
        <div class="overflow-x-auto">
          <div class="card-title mb-2">Detail</div>
          <table class="data-table">
            <thead><tr><th>No.</th><th>{{ contactLabel }}</th><th>Date</th><th>Due</th><th class="num">Days past due</th><th class="num">Balance</th></tr></thead>
            <tbody>
              {{#each report.documents}}
              <tr>
                <td><a href="{{ url }}" class="hover:underline font-mono">{{ number }}</a></td>
                <td>{{ contact }}</td>
                <td>{{ issueDate }}</td>
                <td>{{ dueDate }}</td>
                <td class="num {{#if (gt daysPastDue 0)}}text-destructive{{/if}}">{{ daysPastDue }}</td>
                <td class="num">{{ formatMoney balance }}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{/if}}
      </div>
    </div>
  </main>
</div>
{{> footer }}