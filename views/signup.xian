{{> head}}
<body class="auth-page">
  <div class="auth-shell">
    <div class="auth-main">
      <div class="w-full max-w-[22rem]">
        <div class="flex items-center gap-2.5 mb-10">
          {{> logo class="w-8 h-8" }}
          <span class="text-sm font-semibold">XianFire Accounting</span>
        </div>
        <h1 class="auth-title mb-6">Create an account</h1>
        <div id="signup-error" class="text-destructive pb-3 text-[13px] hidden" role="alert"></div>
        <form id="adminSignupForm" class="space-y-4" method="POST" action="{{ urls.adminSignupJson }}" novalidate
          data-json-form data-custom-error data-redirect="{{ urls.dashboard }}">
          <div>
            <label class="field-label" for="full_name">Full name<span class="required">*</span></label>
            <input id="full_name" name="full_name" type="text" class="input" placeholder="Juan Dela Cruz" autocomplete="name" data-required="Full name is required">
          </div>
          <div>
            <label class="field-label" for="email">Email<span class="required">*</span></label>
            <input id="email" name="email" type="email" class="input" placeholder="you@example.com" autocomplete="username" data-required="Email is required">
          </div>
          <div>
            <label class="field-label" for="password">Password<span class="required">*</span></label>
            <input id="password" name="password" type="password" class="input" autocomplete="new-password" data-required="Password is required">
            <p class="field-help">At least {{ minPasswordLength }} characters</p>
          </div>
          <div>
            <label class="field-label" for="confirm_password">Confirm password<span class="required">*</span></label>
            <input id="confirm_password" name="confirm_password" type="password" class="input" autocomplete="new-password" data-required="Confirm your password">
          </div>
          <div class="form-submit-button pt-2">
            <button type="submit" class="btn btn-primary btn-lg w-full">Sign up</button>
          </div>
        </form>
        <p class="text-[13px] text-muted mt-5">Already have an account? <a href="{{ urls.adminLogin }}" class="text-primary font-medium hover:underline">Sign in</a></p>
      </div>
    </div>
    {{> authAside}}
  </div>
  <script src="/js/signup.js" defer></script>
{{> footer }}
